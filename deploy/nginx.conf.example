# Public edge configuration for SpotTransfer.
#
# Run Gunicorn with backend/config/gunicorn.conf.py. It binds to 127.0.0.1:8081
# so clients cannot bypass these connection, body, and rate limits.

limit_req_zone $binary_remote_addr zone=spottransfer_create_rate:10m rate=1r/s;
limit_req_zone $server_name zone=spottransfer_global_rate:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=spottransfer_create_conn:10m;

upstream spottransfer_backend {
    server 127.0.0.1:8081;
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 15s;
    keepalive_timeout 10s;

    location = /create {
        # The per-instance limit protects the shared Spotify app credential
        # even when requests come from many different client IPs.
        limit_req zone=spottransfer_global_rate burst=5 nodelay;
        limit_req zone=spottransfer_create_rate burst=5 nodelay;
        limit_conn spottransfer_create_conn 5;

        proxy_pass http://spottransfer_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        # Transfers are intentionally allowed to take a long time. The client
        # read timeout above still prevents slowloris-style request pinning.
        proxy_read_timeout 900s;
        proxy_request_buffering on;
    }

    location / {
        proxy_pass http://spottransfer_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }
}
