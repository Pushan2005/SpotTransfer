{
  "name": "spottransfer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/backend"
  ],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:all": "bun scripts/dev.mjs --open",
    "dev:web": "cd apps/web && bun run dev",
    "dev:backend": "cd apps/backend && bun run dev",
    "transfer": "cd apps/backend && bun run transfer",
    "build": "cd apps/web && bun run build",
    "lint": "cd apps/web && bun run lint",
    "preview": "cd apps/web && bun run preview"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.2.19"
    }
  }
}
